{
  "name": "@lition13/markdown-editor",
  "version": "0.1.0",
  "description": "A React Markdown editor with live editing, source mode, editable tables, KaTeX, and Mermaid.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lition13/markdown-editor.git",
    "directory": "packages/markdown-editor"
  },
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "vite build && tsc -p tsconfig.build.json && node build/assets.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "dompurify": "3.4.17",
    "github-slugger": "2.0.0",
    "highlight.js": "11.12.0",
    "katex": "0.19.1",
    "lucide-react": "0.577.0",
    "lowlight": "3.3.0",
    "mermaid": "12.3.0",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "6.0.0",
    "remark-breaks": "4.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  }
}
