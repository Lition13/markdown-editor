{
  "name": "markdown-editor-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/markdown-editor",
    "apps/web"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:package": "npm run build --workspace packages/markdown-editor",
    "build:web": "npm run build --workspace apps/web",
    "build": "npm run build:package && npm run build:web",
    "dev": "npm run build:package && npm run dev --workspace apps/web",
    "preview": "npm run preview --workspace apps/web --",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "overrides": {
    "katex": "0.19.1"
  }
}
